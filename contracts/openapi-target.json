  "components": {
    "schemas": {
      "ExactPatch": {
        "properties": {
          "recognized_quantity": {
            "type": "string",
            "pattern": "^(0|[1-9]\\d{0,11})(\\.\\d{1,6})?$",
            "title": "Recognized Quantity"
          },
          "net_amount": {
            "type": "string",
            "pattern": "^(0|[1-9]\\d{0,13})\\.\\d{2}$",
            "title": "Net Amount"
          },
          "tax_amount": {
            "type": "string",
            "pattern": "^(0|[1-9]\\d{0,13})\\.\\d{2}$",
            "title": "Tax Amount"
          },
          "gross_amount": {
            "type": "string",
            "pattern": "^(0|[1-9]\\d{0,13})\\.\\d{2}$",
            "title": "Gross Amount"
          },
          "status": {
            "type": "string",
            "const": "partially_matched",
            "title": "Status"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "recognized_quantity",
          "net_amount",
          "tax_amount",
          "gross_amount",
          "status"
        ],
        "title": "ExactPatch"
      },
      "FenceCommand": {
        "properties": {
          "operation_key": {
            "type": "string",
            "title": "Operation Key"
          },
          "intent_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "title": "Intent Digest"
          },
          "monotonic_fence": {
            "type": "integer",
            "maximum": 9.223372036854776e+18,
            "minimum": 1.0,
            "title": "Monotonic Fence"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "operation_key",
          "intent_digest",
          "monotonic_fence"
        ],
        "title": "FenceCommand"
      },
      "GrantCommand": {
        "properties": {
          "operation_key": {
            "type": "string",
            "title": "Operation Key"
          },
          "intent_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "title": "Intent Digest"
          },
          "target_id": {
            "type": "string",
            "title": "Target Id"
          },
          "expected_revision": {
            "type": "integer",
            "maximum": 9.223372036854776e+18,
            "minimum": 1.0,
            "title": "Expected Revision"
          },
          "target_fence": {
            "type": "integer",
            "maximum": 9.223372036854776e+18,
            "minimum": 1.0,
            "title": "Target Fence"
          },
          "exact_patch": {
            "$ref": "#/components/schemas/ExactPatch"
          },
          "approval": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Approval"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "operation_key",
          "intent_digest",
          "target_id",
          "expected_revision",
          "target_fence",
          "exact_patch"
        ],
        "title": "GrantCommand"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MutationCommand": {
        "properties": {
          "intent_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "title": "Intent Digest"
          },
          "grant_jti": {
            "type": "string",
            "title": "Grant Jti"
          },
          "fence": {
            "type": "integer",
            "maximum": 9.223372036854776e+18,
            "minimum": 1.0,
            "title": "Fence"
          },
          "exact_patch": {
            "$ref": "#/components/schemas/ExactPatch"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "intent_digest",
          "grant_jti",
          "fence",
          "exact_patch"
        ],
        "title": "MutationCommand"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}